{
  "manifestVersion": 1,
  "connector": "kafka",
  "displayName": "Kafka",
  "kinds": ["source", "sink"],
  "description": "Reads from and writes to Apache Kafka topics.",
  "docsUrl": "https://nightlies.apache.org/flink/flink-docs-stable/docs/connectors/table/kafka/",
  "supportsHealthCheck": false,
  "options": [
    { "key": "topic", "label": "Topic", "type": "string", "required": true, "secret": false,
      "group": "Connection", "placeholder": "my-topic",
      "help": "Topic to read from or write to." },
    { "key": "properties.bootstrap.servers", "label": "Bootstrap servers", "type": "string",
      "required": true, "secret": false, "group": "Connection",
      "placeholder": "kafka:9092",
      "help": "Comma-separated broker list." },
    { "key": "properties.group.id", "label": "Consumer group", "type": "string",
      "required": false, "secret": false, "group": "Connection",
      "help": "Required for sources. Pick a name unique to this job, or it will share offsets with another." },

    { "key": "scan.startup.mode", "label": "Start reading from", "type": "enum",
      "required": false, "secret": false, "group": "Source",
      "default": "group-offsets",
      "choices": ["group-offsets", "earliest-offset", "latest-offset", "timestamp", "specific-offsets"],
      "help": "Where a source begins when it has no committed offset." },
    { "key": "scan.startup.timestamp-millis", "label": "Start timestamp (ms)", "type": "string",
      "required": false, "secret": false, "group": "Source",
      "visibleWhen": { "option": "scan.startup.mode", "equals": "timestamp" } },

    { "key": "format", "label": "Format", "type": "enum", "required": true, "secret": false,
      "group": "Format", "default": "json",
      "choices": ["json", "csv", "avro", "raw", "debezium-json"],
      "help": "How records are encoded. Use 'raw' with a single STRING column to pass whole documents through untouched." },
    { "key": "json.ignore-parse-errors", "label": "Ignore parse errors", "type": "boolean",
      "required": false, "secret": false, "group": "Format", "default": "false",
      "visibleWhen": { "option": "format", "equals": "json" },
      "help": "Skip malformed records instead of failing the job. Off by default: silent data loss is rarely what you want." },
    { "key": "json.timestamp-format.standard", "label": "Timestamp format", "type": "enum",
      "required": false, "secret": false, "group": "Format", "default": "SQL",
      "choices": ["SQL", "ISO-8601"],
      "visibleWhen": { "option": "format", "equals": "json" } },

    { "key": "sink.partitioner", "label": "Partitioner", "type": "enum", "required": false,
      "secret": false, "group": "Sink", "default": "default",
      "choices": ["default", "fixed", "round-robin"],
      "help": "How produced records are assigned to partitions." },

    { "key": "properties.security.protocol", "label": "Security protocol", "type": "enum",
      "required": false, "secret": false, "group": "Security",
      "choices": ["PLAINTEXT", "SSL", "SASL_PLAINTEXT", "SASL_SSL"] },
    { "key": "properties.sasl.mechanism", "label": "SASL mechanism", "type": "enum",
      "required": false, "secret": false, "group": "Security",
      "choices": ["PLAIN", "SCRAM-SHA-256", "SCRAM-SHA-512"] },
    { "key": "properties.sasl.jaas.config", "label": "SASL JAAS config", "type": "password",
      "required": false, "secret": true, "group": "Security",
      "help": "Full JAAS line. Store it as a secret and reference it here." }
  ],
  "columns": []
}
