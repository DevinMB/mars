# Copy to .env. Defaults start a local installation without shared credentials.
TZ=UTC

# Use a reverse proxy or SSH tunnel for remote access (docs/deployment.md).
MARS_CONSOLE_BIND_ADDRESS=127.0.0.1
MARS_CONSOLE_PORT=8080
MARS_FLINK_BIND_ADDRESS=127.0.0.1
MARS_FLINK_UI_PORT=8081

# Set true when the browser accesses MARS through HTTPS.
MARS_SESSION_COOKIE_SECURE=false
MARS_SESSION_COOKIE=mars_session
MARS_SESSION_TTL_HOURS=12
MARS_SEED_EXAMPLES=true

# Browser-facing Flink URL. Set when using a proxy, tunnel, or non-default port.
# MARS_FLINK_UI_URL=https://flink.example.com

# Scheduled check that backups restore (docs/deployment.md#restore-drill). Off by default.
MARS_RESTORE_DRILL=false
# MARS_RESTORE_DRILL_SCHEDULE=0 6 1 1,4,7,10 *
# MARS_RESTORE_DRILL_BACKUPS_DIR=/path/to/backups
