# Copy to .env and adjust. Nothing here is required to start MARS.

TZ=UTC

# Host port for the Flink web UI (read-only ops view).
MARS_FLINK_UI_PORT=8081

# Host port for the MARS console.
MARS_CONSOLE_PORT=8080

# Where a browser can reach the Flink web UI, used only for the "Open in the Flink
# UI" link. Leave it unset unless you need to: MARS reaches Flink over the internal
# network at http://jobmanager:8081, which no browser can resolve, so the console
# builds the link from whatever address you opened it at, on MARS_FLINK_UI_PORT.
# Set this when that guess is wrong -- behind a reverse proxy, or when the UI is
# published on a different host or port than the console.
# MARS_FLINK_UI_URL=https://flink.example.com
