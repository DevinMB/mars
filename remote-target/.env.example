# The image MARS built. Either push it to a registry both hosts can reach, or
# copy it over with:  docker save mars/flink:0.1.0 | ssh <host> docker load
MARS_FLINK_IMAGE=mars/flink:0.1.0

TZ=UTC

# Published ports. MARS needs to reach both from wherever the console runs.
# This machine's own private IP (hostname -I): the address the MARS host
# connects to. Not the MARS host's address.
TARGET_BIND_ADDRESS=127.0.0.1
TARGET_REST_PORT=8081
TARGET_GATEWAY_PORT=8083

# Size to the machine. A TaskManager's memory is what bounds how much state a job
# on this target can hold.
JOBMANAGER_MEM=1280m
TASKMANAGER_MEM=2560m
